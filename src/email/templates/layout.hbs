<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { 
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; 
      line-height: 1.6; 
      color: #333; 
      background-color: #F8FAFC;
      margin: 0;
      padding: 40px 20px;
    }
    .container { 
      max-width: 600px; 
      margin: 0 auto; 
      background-color: #FFFFFF;
      border-radius: 8px; 
      overflow: hidden;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }
    .header { 
      background-color: #0F172A; 
      padding: 30px 20px; 
      text-align: center; 
    }
    .header img {
      max-width: 180px;
      height: auto;
    }
    .content { 
      padding: 40px 30px; 
    }
    .footer { 
      font-size: 13px; 
      color: #64748B; 
      text-align: center; 
      background-color: #F8FAFC;
      padding: 24px;
      border-top: 1px solid #E2E8F0;
    }
    .button { 
      display: inline-block; 
      padding: 12px 28px; 
      background-color: #2563EB; 
      color: #FFFFFF !important; 
      text-decoration: none; 
      border-radius: 6px; 
      font-weight: 600;
      margin-top: 24px;
      font-size: 15px;
    }
    .button:hover {
      background-color: #1D4ED8;
    }
    .badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .badge.priority-high, .badge.priority-High, .badge.priority-urgent, .badge.priority-Urgent { background-color: #FEF2F2; color: #DC2626; }
    .badge.priority-medium, .badge.priority-Medium { background-color: #FFFBEB; color: #D97706; }
    .badge.priority-low, .badge.priority-Low { background-color: #EFF6FF; color: #2563EB; }
    
    .badge.status-open, .badge.status-Open { background-color: #EFF6FF; color: #2563EB; }
    .badge.status-pending, .badge.status-Pending { background-color: #FFFBEB; color: #D97706; }
    .badge.status-resolved, .badge.status-Resolved { background-color: #F0FDF4; color: #16A34A; }
    
    h2 {
      color: #0F172A;
      margin-top: 0;
      margin-bottom: 24px;
      font-size: 24px;
    }
    p {
      margin-bottom: 16px;
      color: #475569;
      font-size: 15px;
    }
    .info-box {
      background-color: #F8FAFC;
      border: 1px solid #E2E8F0;
      border-radius: 8px;
      padding: 20px;
      margin-top: 24px;
      margin-bottom: 24px;
    }
    .info-row {
      margin-bottom: 12px;
    }
    .info-row:last-child {
      margin-bottom: 0;
    }
    .info-label {
      font-weight: 600;
      color: #0F172A;
      display: inline-block;
      width: 100px;
      font-size: 14px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <img src="https://res.cloudinary.com/oaetuek3/image/upload/v1786881893/branding/ipmvlrucrnwjwl6fjmbx.png" alt="Fonu Desk" />
    </div>
    <div class="content">
      {{{body}}}
    </div>
    <div class="footer">
      <p style="margin-bottom: 8px; color: #64748B;">This is an automated message from Fonu Desk. Please do not reply directly to this email.</p>
      <p style="margin-bottom: 0; color: #94A3B8;">&copy; 2026 Fonu Desk. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
